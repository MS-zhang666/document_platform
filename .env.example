APP_NAME=Async Document Platform
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://docuser:docpass@localhost:5432/docplatform

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

STORAGE_ROOT=./data

MAX_UPLOAD_BYTES=20971520

JOB_STATE_TTL_SECONDS=86400
WORKER_MAX_JOBS=4
JOB_TIMEOUT_SECONDS=180
MAX_JOB_TRIES=3
